# NEXUS environment — copy to .env, never commit .env
WSS_RPC_URL=wss://YOUR_PROVIDER_ENDPOINT
HTTP_RPC_URL=https://YOUR_PROVIDER_ENDPOINT
WSS_RPC_URL_BASE=wss://YOUR_BASE_PROVIDER_ENDPOINT
HTTP_RPC_URL_BASE=https://YOUR_BASE_PROVIDER_ENDPOINT
# Optional failover providers (leave blank to disable)
WSS_RPC_URL_SECONDARY=
HTTP_RPC_URL_SECONDARY=
WSS_RPC_URL_BASE_SECONDARY=
HTTP_RPC_URL_BASE_SECONDARY=
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
# Cold-start depth when a chain has no checkpoint row yet (per-chain
# chains.json "start_block" overrides this)
START_BACKFILL_BLOCKS=50
# Fetch tx+receipt rows for each log's transaction (set false to disable)
INGEST_TRANSACTIONS=true
# Engine 4 (dex_monitor): alert when one removal >= this % of pool liquidity
LIQ_REMOVAL_ALERT_PCT=20
DEX_CHAIN_IDS=1,8453
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# Engine 6: OpenAI-compatible endpoint (e.g. free local Ollama:
# LLM_BASE_URL=http://host.docker.internal:11434/v1, LLM_API_KEY=ollama).
# LLM_PROVIDER=deterministic -> offline template reports, no HTTP, $0.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Engine 6 auto-trigger from Stage A alerts (default on, bounded)
INVESTIGATOR_AUTO_TRIGGER=true
INVESTIGATOR_AUTO_MAX_PER_HOUR=20
WHALE_THRESHOLD_ETH=100

# Engine 3 (wallet_intelligence)
CONSUMER_NAME=wallet-intel-1
ACCUMULATION_WINDOW_DAYS=7
SCORE_REFRESH_SECONDS=300

# Engine 2 (mempool_listener)
MEMPOOL_DROP_AFTER_BLOCKS=50
MEMPOOL_MAX_INFLIGHT=200

# Engine 7 (alerts/API)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
NEXUS_API_KEY=
ALERT_WEBHOOK_URLS=
WEBHOOK_SECRET=
EXECUTION_ENABLED=false

# Engine 1 scoped filters
LOG_FILTER_MODE=scoped        # scoped (default) | full (unscoped subscriptions)
FILTER_REFRESH_SECONDS=60     # re-read watchlists/pools this often
MAX_FILTER_ADDRESSES=10       # max addresses per eth_getLogs / WS filter
