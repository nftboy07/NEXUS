{"$schema": "https://json-schema.org/draft/2020-12/schema", "properties": {"block_hash": {"type": ["string", "null"]}, "block_number": {"type": ["integer", "null"]}, "chain_id": {"type": "integer"}, "dedup_key": {"description": "chain_id:block_hash:tx_hash:log_index for logs", "type": "string"}, "kind": {"enum": ["block", "log", "transfer", "pending_tx", "liquidity", "block_removed"]}, "log_index": {"type": ["integer", "null"]}, "payload": {"type": "object"}, "tx_hash": {"type": ["string", "null"]}}, "required": ["chain_id", "kind", "block_number", "tx_hash", "dedup_key"], "title": "NexusNormalizedEvent", "type": "object", "description": "Normalized event published to nexus:events. 'block_removed' (kind) is emitted when a block is orphaned by a reorg; downstream engines must invalidate rows derived from that block_hash."}